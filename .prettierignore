# Read from the repo root — `pnpm format` runs Prettier once from here. Prettier resolves
# the ignore file relative to the working directory (unlike .prettierrc, which it finds by
# walking up), so a per-workspace run would silently ignore nothing at all.

node_modules
**/node_modules

# Build outputs, mirroring .gitignore
dist
**/dist
coverage
**/coverage

# Expo's caches and the native projects it generates
apps/web/.expo
apps/web/.expo-shared
apps/web/ios
apps/web/android

# Generated by `prisma generate` and rewritten on every run
apps/server/src/generated

# Hand-written SQL — Prettier has no parser for it, but keep it stated so nobody adds one
apps/server/prisma/migrations

# The designer's exports, copied in byte for byte. Reformatting one destroys the only thing
# they are good for: diffing the next export against this one to see what actually changed.
design_handoff_cuzhane

# Astro components. Prettier needs `prettier-plugin-astro` to parse a `.astro` file at all,
# and without it every one of them is an error rather than a skip. The plugin is a dependency
# for formatting alone; these files are hand-formatted to match the rest of the repo instead.
*.astro
**/*.astro

# Lockfile. Prettier *will* reformat this YAML, and a reformatted lockfile is a diff nobody
# wants and a merge conflict waiting to happen. (The old entry here named package-lock.json,
# which this repo has never had — it is pnpm.)
pnpm-lock.yaml
