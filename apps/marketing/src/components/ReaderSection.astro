---
import { Image } from 'astro:assets';
import readerShot from '../assets/07-reader.png';
import { copyFor, type Locale } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);
---

<section id="okuma" class="shell section reader">
	<div class="copy">
		<p class="eyebrow reveal">{t.readerEyebrow}</p>
		<h2 class="reveal">{t.readerTitle}</h2>
		<p class="lede reveal">{t.readerBody}</p>

		<ul class="bullets">
			{
				t.readerBullets.map(bullet => (
					<li class="reveal">
						<span class="tick" aria-hidden="true">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12.6l4.4 4.4L19 7.4" />
							</svg>
						</span>
						<span>{bullet}</span>
					</li>
				))
			}
		</ul>
	</div>

	<div class="stage">
		<Image class="phone reveal" src={readerShot} alt={t.shotReader} widths={[300, 600, 900]} sizes="300px" />
	</div>
</section>

<style>
	.reader {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 40px;
		align-items: center;
	}

	.copy {
		order: 1;
	}

	.stage {
		order: 2;
		display: flex;
		justify-content: center;
	}

	h2 {
		max-width: 420px;
	}

	.bullets {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.bullets li {
		display: flex;
		gap: 11px;
		align-items: flex-start;
		font: 400 13.5px/1.6 var(--sans);
		color: rgba(28, 29, 26, 0.68);
		text-wrap: pretty;
	}

	.tick {
		flex: none;
		width: 20px;
		height: 20px;
		border-radius: 6px;
		background: var(--sage-wash);
		color: var(--sage);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 1px;
	}

	.phone {
		flex: none;
		width: 300px;
		max-width: 100%;
		height: auto;
		border-radius: 34px;
		box-shadow:
			0 22px 54px rgba(28, 29, 26, 0.16),
			0 0 0 8px #16171a;
		display: block;
	}
</style>
