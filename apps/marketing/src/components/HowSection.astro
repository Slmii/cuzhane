---
import { copyFor, type Locale } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);
---

<section id="nasil" class="shell section">
	<p class="eyebrow reveal">{t.howEyebrow}</p>
	<h2 class="reveal wide">{t.howTitle}</h2>

	<ol class="steps">
		{
			t.steps.map(step => (
				<li class="step reveal">
					<span class="n">{step.n}</span>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
				</li>
			))
		}
	</ol>
</section>

<style>
	h2.wide {
		max-width: 600px;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 14px;
		margin: 34px 0 0;
		padding: 0;
		list-style: none;
		/* The numbers are content here — `01`, `02`, `03` are printed in the design — so the
		   list is ordered and the marker is suppressed rather than faked with a div. */
		counter-reset: step;
	}

	.step {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 22px;
		padding: 26px 24px 24px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s cubic-bezier(0.2, 0.9, 0.25, 1);
	}

	.step:hover {
		border-color: rgba(62, 107, 92, 0.4);
		box-shadow: 0 14px 34px rgba(28, 29, 26, 0.09);
		transform: translateY(-3px);
	}

	.n {
		font: 500 10.5px var(--mono);
		color: var(--sage);
	}

	.step h3 {
		font: 400 22px/1.2 var(--serif);
		margin: 0;
	}

	.step p {
		font: 400 13.5px/1.65 var(--sans);
		color: var(--muted);
		margin: 0;
		text-wrap: pretty;
	}
</style>
