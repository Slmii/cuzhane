---
interface Props {
	size?: number;
}

const { size = 30 } = Astro.props;

/**
 * The gold rosette on its green disc — cut from the app icon (`public/brand-mark.png`), so the
 * site and the icon cannot drift apart.
 */
---

<img src="/brand-mark.png" width={size} height={size} alt="" />

<style>
	img {
		display: block;
		flex: none;
	}
</style>
