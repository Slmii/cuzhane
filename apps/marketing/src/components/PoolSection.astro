---
import { copyFor, type Locale } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);

/**
 * A round's hundred babs, in the states the design's prototype set them: read, claimed, still
 * in the pool, untouched. The same four states the legend below the grid names.
 */
const STATES = Array.from({ length: 100 }, (_, index) => {
	const bab = index + 1;

	if (bab <= 46) return 0;
	if (bab <= 62) return 1;
	if (bab <= 74) return 2;
	if (bab <= 78) return 0;
	if (bab <= 88) return 1;

	return 3;
});

const STATE_CLASS = ['read', 'claimed', 'pool', 'idle'] as const;
---

<section id="havuz" class="shell section pool">
	<div>
		<p class="eyebrow sage reveal">{t.poolEyebrow}</p>
		<h2 class="reveal">{t.poolTitle}</h2>
		<p class="lede reveal">{t.poolBody}</p>

		<div class="stats">
			{
				t.poolStats.map(stat => (
					<div class="stat reveal">
						<span class="stat-v">{stat.v}</span>
						<span class="stat-l">{stat.l}</span>
					</div>
				))
			}
		</div>
	</div>

	<div class="board">
		<div class="grid" role="img" aria-label={t.poolGridAlt}>
			{STATES.map(state => <span class:list={['cell', STATE_CLASS[state]]} />)}
		</div>
		<ul class="legend">
			{
				t.poolLegend.map((label, index) => (
					<li>
						<span class:list={['swatch', STATE_CLASS[index]]} />
						{label}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.pool {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 36px;
		align-items: start;
	}

	.eyebrow.sage {
		color: var(--sage);
	}

	h2 {
		max-width: 460px;
	}

	.stats {
		display: flex;
		gap: 26px;
		flex-wrap: wrap;
		margin-top: 28px;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.stat-v {
		font: 400 30px/1 var(--serif);
		color: var(--sage);
	}

	.stat-l {
		font: 500 10.5px var(--sans);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(28, 29, 26, 0.5);
	}

	.board {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 24px;
		padding: 24px 22px 20px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		gap: 4px;
	}

	.cell {
		aspect-ratio: 1;
		border-radius: 5px;
		border: 1px solid transparent;
		box-sizing: border-box;
	}

	/* The four states, matching the app's own board: solid accent for read, a soft wash for a
	   claimed bab, a dashed sand tile for one still in the pool, and paper for untouched. */
	.read,
	.swatch.read {
		background: var(--sage);
	}

	.claimed,
	.swatch.claimed {
		background: #c9dcd2;
	}

	.pool-cell,
	.cell.pool,
	.swatch.pool {
		background: #f7eedc;
		border: 1px dashed #c79a4f;
	}

	.idle,
	.swatch.idle {
		background: #eceae4;
	}

	.legend {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		margin: 18px 0 0;
		padding: 16px 0 0;
		border-top: 1px solid rgba(28, 29, 26, 0.08);
		list-style: none;
	}

	.legend li {
		display: flex;
		align-items: center;
		gap: 7px;
		font: 400 11.5px var(--sans);
		color: var(--muted);
	}

	.swatch {
		width: 11px;
		height: 11px;
		border-radius: 3px;
		box-sizing: border-box;
	}
</style>
