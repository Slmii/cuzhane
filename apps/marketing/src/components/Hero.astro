---
import { Image } from 'astro:assets';
import homeShot from '../assets/01-home.png';
import { copyFor, type Locale } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);
---

<section class="hero">
	<div class="copy">
		<p class="eyebrow light">{t.heroEyebrow}</p>
		<h1>{t.heroTitle}</h1>
		<p class="body">{t.heroBody}</p>
		<div class="ctas">
			<a class="cta solid" href="#indir">{t.ctaGet}</a>
			<a class="cta ghost" href="#indir">{t.ctaJoin}</a>
		</div>
		<p class="meta">{t.heroMeta}</p>
	</div>

	{/*
	 * **A real screenshot, not a drawing.** This was a hand-built CSS replica of Ana sayfa —
	 * chosen so it would stay sharp at any density and never go stale. The design replaced it,
	 * and it is the right call: a drawn approximation quietly misrepresents the product, and
	 * every app change made the two drift anyway. `astro:assets` answers the sharpness half at
	 * build time — it emits width-appropriate WebP and the `srcset` to pick between them, so
	 * the 1320px-wide source never reaches anyone.
	 *
	 * `loading='eager'` because this is the LCP element; lazy-loading the hero image is how
	 * you lose a second of Largest Contentful Paint to a request that could have started in
	 * the markup.
	 */}
	<div class="stage">
		<Image class="phone" src={homeShot} alt={t.shotHome} widths={[300, 600, 900]} sizes="300px" loading="eager" />
	</div>
</section>

<style>
	.hero {
		background: var(--sage);
		border-radius: 30px;
		margin-top: 14px;
		padding: clamp(34px, 4vw, 56px) clamp(22px, 3.4vw, 44px) 0;
		overflow: hidden;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: clamp(26px, 3vw, 40px);
		align-items: end;
	}

	.copy {
		padding-bottom: clamp(34px, 4vw, 58px);
	}

	/*
	 * **The entrance is an enhancement, and it is opt-in.** These used to be unconditional
	 * `animation: … both` declarations, which meant the hero's copy and the phone were
	 * `opacity: 0` until the animation ran — so with Reduce Motion on, or in any renderer that
	 * doesn't run the animation, the hero was an empty green box. Caught by screenshotting with
	 * `--force-prefers-reduced-motion`. Content must be visible first and animate second.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.copy {
			animation: cz-rise 0.6s cubic-bezier(0.2, 0.9, 0.25, 1) both;
		}

		/*
		 * Rises once, then breathes. The float is the design's, and it is deliberately slow
		 * and tiny — 9s for 6px — so it reads as the page being alive rather than as
		 * something asking to be looked at. Both are inside this query, so Reduce Motion
		 * gets a still phone rather than a slower one.
		 */
		.phone {
			animation:
				cz-rise 0.8s cubic-bezier(0.2, 0.9, 0.25, 1) 0.12s both,
				cz-float 9s ease-in-out 1.4s infinite;
		}
	}

	@keyframes cz-float {
		0%,
		100% {
			transform: none;
		}
		50% {
			transform: translateY(-6px);
		}
	}

	.eyebrow.light {
		color: rgba(255, 255, 255, 0.62);
	}

	h1 {
		font-size: clamp(38px, 5vw, 60px);
		line-height: 1.06;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 16px 0 0;
	}

	.body {
		font: 400 16px/1.65 var(--sans);
		color: rgba(255, 255, 255, 0.76);
		margin: 18px 0 0;
		max-width: 460px;
		text-wrap: pretty;
	}

	.ctas {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		margin-top: 30px;
	}

	.cta {
		text-decoration: none;
		border-radius: 14px;
		padding: 15px 24px;
		font: 600 13.5px var(--sans);
		transition:
			transform 0.22s cubic-bezier(0.2, 0.9, 0.25, 1),
			box-shadow 0.22s ease,
			background 0.22s ease;
	}

	.cta.solid {
		background: #fff;
		color: var(--ink);
	}

	.cta.solid:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.22);
	}

	.cta.ghost {
		background: rgba(255, 255, 255, 0.14);
		border: 1px solid rgba(255, 255, 255, 0.28);
		color: #fff;
	}

	.cta.ghost:hover {
		background: rgba(255, 255, 255, 0.24);
		transform: translateY(-2px);
	}

	.meta {
		font: 400 12px var(--sans);
		color: rgba(255, 255, 255, 0.82);
		margin: 18px 0 0;
	}

	.stage {
		display: flex;
		justify-content: center;
		align-items: flex-end;
	}

	/*
	 * **Cropped, not scaled.** The screenshot is 1320×2868 — at 300px wide it wants to be
	 * 652px tall, and the design gives it 560. `object-fit: cover` with the origin pinned to
	 * the top keeps the greeting and the streak card at full size and lets the bottom run off
	 * the fold, which is what the square-off corners (`38px 38px 0 0`) are drawn for. Scaling
	 * the whole screen down to fit instead would shrink the text into illegibility.
	 */
	.phone {
		flex: none;
		width: 300px;
		max-width: 100%;
		height: 560px;
		object-fit: cover;
		object-position: top center;
		border-radius: 38px 38px 0 0;
		box-shadow:
			0 -6px 60px rgba(0, 0, 0, 0.28),
			0 0 0 8px #16171a;
		display: block;
	}

</style>
