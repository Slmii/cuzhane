---
import { Image } from 'astro:assets';
import groupShot from '../assets/04-group.png';
import { copyFor, type Locale } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);
---

<section id="ilerleme" class="shell section progress">
	<div>
		<p class="eyebrow reveal">{t.progEyebrow}</p>
		<h2 class="reveal">{t.progTitle}</h2>
		<p class="lede reveal">{t.progBody}</p>
	</div>

	{/*
	 * The board as it actually looks, rather than a card approximating it. Same treatment as
	 * the reader's shot below — a 34px frame and the 8px bezel the design uses everywhere a
	 * phone appears on the page.
	 */}
	<div class="stage">
		<Image class="phone reveal" src={groupShot} alt={t.shotGroup} widths={[300, 600, 900]} sizes="300px" />
	</div>
</section>

<style>
	.progress {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 40px;
		align-items: center;
	}

	h2 {
		max-width: 440px;
	}

	.stage {
		display: flex;
		justify-content: center;
	}

	.phone {
		flex: none;
		width: 300px;
		max-width: 100%;
		height: auto;
		border-radius: 34px;
		box-shadow:
			0 22px 54px rgba(28, 29, 26, 0.16),
			0 0 0 8px #16171a;
		display: block;
	}
</style>
