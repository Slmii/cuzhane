---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { KIND_TONES, type KindKey } from './kindTones';

interface Props {
	kind: KindKey;
	eyebrow: string;
	title: string;
	body: string;
	bullets: readonly string[];
	/** The group's screen in front, the reader behind it and lower. */
	front: { src: ImageMetadata; alt: string };
	back: { src: ImageMetadata; alt: string };
	/** Only the first of the three stands off the section above; the other two sit close under it. */
	isFirst?: boolean;
}

const { back, body, bullets, eyebrow, front, isFirst = false, kind, title } = Astro.props;
const tone = KIND_TONES[kind];
---

{/*
  One reading's section — the Cevşen's sage, the Kur'an's sand or the Hizb's rose. The copy and
  three ticked bullets on one side, two phones on the other: the group's screen in front, the
  reader tucked behind it and lower, as the design overlaps them.
*/}
<div class="shell">
	<section
		id={kind}
		class:list={['kind', { first: isFirst }]}
		style={`--wash:${tone.wash};--rim:${tone.rim};--ink-kind:${tone.ink};--tick:${tone.tick}`}
	>
		<div class="copy">
			<p class="eyebrow reveal">{eyebrow}</p>
			<h2 class="reveal">{title}</h2>
			<p class="lede reveal">{body}</p>

			<ul class="bullets">
				{
					bullets.map(bullet => (
						<li class="reveal">
							<span class="tick" aria-hidden="true">
								<svg
									width="13"
									height="13"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M5 12.6l4.4 4.4L19 7.4" />
								</svg>
							</span>
							<span>{bullet}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="stage">
			<Image class="phone front reveal" src={front.src} alt={front.alt} widths={[250, 500, 750]} sizes="250px" />
			<Image class="phone back reveal" src={back.src} alt={back.alt} widths={[230, 460, 690]} sizes="230px" />
		</div>
	</section>
</div>

<style>
	.kind {
		margin-top: 22px;
		background: var(--wash);
		border: 1px solid var(--rim);
		border-radius: 30px;
		padding: clamp(34px, 4vw, 56px) clamp(22px, 3.4vw, 48px);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 44px;
		align-items: center;
	}

	.kind.first {
		margin-top: 78px;
	}

	.eyebrow {
		color: var(--ink-kind);
	}

	h2 {
		font-size: clamp(28px, 3.4vw, 40px);
		line-height: 1.14;
		margin: 12px 0 0;
		max-width: 460px;
	}

	.lede {
		font: 400 14.5px/1.7 var(--sans);
		color: rgba(28, 29, 26, 0.7);
		max-width: 440px;
	}

	.bullets {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.bullets li {
		display: flex;
		gap: 11px;
		align-items: flex-start;
		font: 400 13.5px/1.6 var(--sans);
		color: rgba(28, 29, 26, 0.74);
		text-wrap: pretty;
	}

	.tick {
		flex: none;
		width: 20px;
		height: 20px;
		border-radius: 6px;
		background: var(--tick);
		color: var(--ink-kind);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 1px;
	}

	.tick svg {
		display: block;
	}

	.stage {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding: 10px 0 30px;
	}

	.phone {
		flex: none;
		height: auto;
		display: block;
		position: relative;
	}

	.front {
		width: 250px;
		max-width: 48%;
		border-radius: 30px;
		box-shadow:
			0 22px 54px rgba(28, 29, 26, 0.18),
			0 0 0 7px #16171a;
		z-index: 2;
	}

	.back {
		width: 230px;
		max-width: 44%;
		margin: 48px 0 0 -34px;
		border-radius: 28px;
		box-shadow:
			0 22px 54px rgba(28, 29, 26, 0.16),
			0 0 0 7px #16171a;
		z-index: 1;
	}
</style>
