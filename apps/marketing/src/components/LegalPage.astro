---
import type { Locale } from '../i18n/copy';
import type { LegalPage } from '../i18n/legal';
import Page from '../layouts/Page.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
	locale: Locale;
	path: string;
	page: LegalPage;
}

const { locale, page, path } = Astro.props;
---

<Page
	locale={locale}
	path={path}
	title={page.metaTitle}
	description={page.metaDescription}
>
	<SiteHeader locale={locale} />

	<main id="main" class="shell prose">
		<h1>{page.title}</h1>
		<p class="updated"><time datetime={page.updated}>{page.updated}</time></p>
		<p class="intro">{page.intro}</p>

		{
			page.sections.map(section => (
				<section>
					<h2>{section.heading}</h2>
					{section.paragraphs.map(paragraph => (
						<p>{paragraph}</p>
					))}
					{section.bullets ? (
						<ul>
							{section.bullets.map(bullet => (
								<li>{bullet}</li>
							))}
						</ul>
					) : null}
				</section>
			))
		}
	</main>

	<SiteFooter locale={locale} />
</Page>

<style>
	/* A reading measure, not the marketing page's full width. */
	.prose {
		max-width: 720px;
		padding-top: 40px;
		padding-bottom: 40px;
	}

	h1 {
		font-size: clamp(32px, 4vw, 44px);
		line-height: 1.1;
		margin: 0;
	}

	.updated {
		font: 500 11px var(--mono);
		letter-spacing: 0.06em;
		color: var(--faint);
		margin: 10px 0 0;
	}

	.intro {
		font: 400 16px/1.7 var(--sans);
		color: var(--ink);
		margin: 22px 0 0;
		text-wrap: pretty;
	}

	section {
		margin-top: 34px;
	}

	h2 {
		font-size: 21px;
		line-height: 1.3;
		margin: 0 0 10px;
	}

	p {
		font: 400 14.5px/1.75 var(--sans);
		color: rgba(28, 29, 26, 0.72);
		margin: 0 0 12px;
		text-wrap: pretty;
	}

	ul {
		margin: 0;
		padding-left: 20px;
	}

	li {
		font: 400 14.5px/1.75 var(--sans);
		color: rgba(28, 29, 26, 0.72);
		margin-bottom: 8px;
		text-wrap: pretty;
	}
</style>
