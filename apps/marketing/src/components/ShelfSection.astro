---
import { copyFor, type Locale } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);

/** Fourteen uneven columns — the design's own heights. Ten are read, four are not. */
const COLUMNS = [58, 92, 74, 120, 66, 104, 84, 112, 70, 96, 50, 118, 80, 62];
const READ_COUNT = 10;
---

<section class="shell">
	<div class="shelf">
		<div>
			<h2 class="reveal">{t.shelfTitle}</h2>
			<p class="body">{t.shelfBody}</p>
		</div>

		<div class="chart" aria-hidden="true">
			<div class="cols">
				{
					COLUMNS.map((height, index) => (
						<span
							class:list={['col', { faint: index >= READ_COUNT }]}
							style={`height:${height}px`}
						/>
					))
				}
			</div>
			<div class="rule"></div>
			<div class="ends">
				<span>{t.shelfLeft}</span>
				<span>{t.shelfRight}</span>
			</div>
		</div>
	</div>
</section>

<style>
	.shelf {
		margin-top: 78px;
		background: var(--sand);
		border: 1px solid rgba(28, 29, 26, 0.08);
		border-radius: 26px;
		padding: 38px 34px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 32px;
		align-items: center;
	}

	h2 {
		font-size: clamp(22px, 2.6vw, 30px);
		line-height: 1.25;
		letter-spacing: -0.01em;
		margin: 0;
		max-width: 380px;
	}

	.body {
		font: 400 13.5px/1.65 var(--sans);
		color: rgba(28, 29, 26, 0.68);
		margin: 12px 0 0;
		max-width: 400px;
		text-wrap: pretty;
	}

	.chart {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.cols {
		display: flex;
		align-items: flex-end;
		gap: 6px;
		height: 120px;
	}

	.col {
		flex: 1;
		border-radius: 5px;
		background: var(--sage);
		transform-origin: bottom;
	}

	.col.faint {
		background: rgba(28, 29, 26, 0.14);
	}

	.rule {
		height: 8px;
		border-radius: 4px;
		background: var(--sage);
	}

	.ends {
		display: flex;
		justify-content: space-between;
		font: 500 10px var(--mono);
		color: rgba(28, 29, 26, 0.45);
	}
</style>
