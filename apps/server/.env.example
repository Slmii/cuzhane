NODE_ENV=development
PORT=3001
CORS_ORIGIN=*
DATABASE_URL=postgresql://cuzhane:cuzhane@localhost:5433/cuzhane
CLERK_PUBLISHABLE_KEY=your_key_here
CLERK_SECRET_KEY=your_key_here
APP_STORE_URL=

# `pnpm db:seed` — the Clerk accounts the dev fixtures belong to, comma-separated. Each gets
# its own copy of every group. Development only.
# SEED_USER_IDS=user_aaa,user_bbb

# Quran Foundation API — used ONLY by `pnpm cuz:fetch`, which is run by hand and whose
# output is committed. Nothing at runtime reads these, and they must never reach the client:
# the docs are explicit that client_secret belongs on a server, and EXPO_PUBLIC_* is inlined
# into the app bundle. Request credentials at https://api-docs.quran.foundation
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# Cloudflare Realtime and TURN — a live reader's voice, carried by Cloudflare to the people
# following. Server-side only; the app never holds them. Left blank, voice answers "unavailable"
# and live reading works as before. Create them in the Cloudflare dashboard (Realtime → SFU app,
# and a TURN key).
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=
