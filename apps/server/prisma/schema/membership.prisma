// Who is in a group, who wants in, and the encouragement they send each other.

enum GroupMemberRole {
    OWNER
    MEMBER
}

model GroupMember {
    id          String          @id @default(cuid())
    groupId     String
    userId      String
    displayName String
    role        GroupMemberRole @default(MEMBER)
    slotIndex   Int
    joinedAt    DateTime        @default(now())
    // "Bu grupta hep kitaptan okuyorum": on a Hizb plan, the book button leads and the reader is a link.
    readsFromBook Boolean       @default(false)
    // A Hizb plan with hidden names: one of up to three the owner ticks (the owner by default) who
    // see who read and get every "has read" notice, whatever their own settings say.
    seesReaders   Boolean       @default(false)

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId])
    @@unique([groupId, slotIndex])
    @@index([userId])
}

model Cheer {
    id         String   @id @default(cuid())
    groupId    String
    fromUserId String
    toUserId   String
    createdAt  DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, fromUserId, toUserId])
    @@index([groupId, toUserId])
}

model GroupWaitlistEntry {
    id        String   @id @default(cuid())
    groupId   String
    userId    String
    createdAt DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId])
    @@index([userId])
}
