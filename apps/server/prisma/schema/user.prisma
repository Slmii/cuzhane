// Per-user state that isn't tied to a single group. Identity itself lives in Clerk;
// `userId` is the Clerk user id everywhere.

enum AppLanguage {
    tr
    en
}

model UserSettings {
    id                String      @id @default(cuid())
    userId            String      @unique
    language          AppLanguage @default(en)
    reminderEnabled   Boolean     @default(false)
    reminderTime      String      @default("21:30")
    nudgeEnabled      Boolean     @default(true)
    hasSeenOnboarding Boolean     @default(false)
    readerFontScale   Int         @default(1)
    createdAt         DateTime    @default(now())
    updatedAt         DateTime    @updatedAt
}

model PushToken {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

enum FeedbackTopic {
    BUG
    IDEA
    OTHER
}

model Feedback {
    id         String        @id @default(cuid())
    reference  String        @unique
    userId     String
    topic      FeedbackTopic
    message    String
    email      String?
    appVersion String?
    platform   String?
    locale     String?
    createdAt  DateTime      @default(now())

    @@index([userId, createdAt])
}
