// Per-user state that isn't tied to a single group. Identity itself lives in Clerk;
// `userId` is the Clerk user id everywhere.

enum AppLanguage {
    tr
    en
    nl
}

enum ReaderNumerals {
    arabic
    latin
}

// `husrev` is not a font: it is the Kuran reader's Hüsrev hattı page images. The Cevşen has
// no page images, so its readers draw the default font for it — see `textFontFor` in the app.
enum ReaderArabicFont {
    naskh
    amiri
    uthman
    husrev
}

model UserSettings {
    id                   String           @id @default(cuid())
    userId               String           @unique
    language             AppLanguage      @default(en)
    reminderEnabled      Boolean          @default(false)
    reminderTime         String           @default("21:30")
    /// The daily reminder for the Hizbü'l-Hakaik's groups — its own switch and its own time;
    /// `reminderEnabled` and `reminderTime` are the Cevşen's. On for a new account; every account
    /// that existed when it arrived kept what its one daily reminder was (`hizb_reminder_follows_daily`).
    hizbReminderEnabled  Boolean          @default(true)
    hizbReminderTime     String           @default("21:30")
    /// Three notifications are **per reading type**, because they describe different work:
    /// "someone finished their share" is a bab range in one and a cüz in the other, and a
    /// reader in both wants to hear about them separately.
    ///
    /// The Cevşen three keep their original columns via `@map` — renaming a column outright
    /// is a drop and an add, which would have silently reset everyone's preferences. The
    /// field names are what the code reads, so nothing may refer to the bare old names.
    cevsenGroupReadsEnabled    Boolean @default(false) @map("groupReadsEnabled")
    cevsenRoundCompleteEnabled Boolean @default(true)  @map("roundCompleteEnabled")
    cevsenPoolClaimEnabled     Boolean @default(false) @map("poolClaimEnabled")

    /// The same three for a hatim, defaulting exactly as their Cevşen twins do — the round
    /// completing is the moment the app is built around, so it is the one that is opt-out.
    hatimGroupReadsEnabled    Boolean @default(false)
    hatimRoundCompleteEnabled Boolean @default(true)
    hatimPoolClaimEnabled     Boolean @default(false)

    /// A Hizb group's "someone finished their reading", its own switch. Responsible members
    /// (`GroupMember.seesReaders`) hear it whatever this says. Hizb's other notices still answer
    /// to the Cevşen switches.
    hizbGroupReadsEnabled Boolean @default(false)

    /// Who is in the group is the same event whatever the group reads, so these two are
    /// shared — the "Genel" section.
    memberJoinedEnabled  Boolean          @default(false)
    memberLeftEnabled    Boolean          @default(false)
    nudgeEnabled         Boolean          @default(true)
    hasSeenOnboarding    Boolean          @default(false)
    hasSeenTour          Boolean          @default(false)
    /// Per-screen hints (which replaced the guided tour): whether they show at all.
    hintsEnabled         Boolean          @default(true)
    /// Set once the account marks any hint seen. Old builds read `hasSeenTour` as this OR the
    /// column, so they stop auto-starting the demo tour for an account that uses hints.
    hasUsedHints         Boolean          @default(false)
    /// "Grubun nasıl çalışır?" after joining, one switch per kind: "bir daha gösterme" on one kind
    /// leaves the others showing. Shown after joining a Cevşen group.
    cevsenIntroEnabled   Boolean          @default(true)
    /// Shown after joining a Kur'an group.
    hatimIntroEnabled    Boolean          @default(true)
    /// Shown after joining a Hizb group.
    hizbIntroEnabled     Boolean          @default(true)
    readerFontSize       Int              @default(23)
    readerNumerals       ReaderNumerals   @default(arabic)
    readerArabicFont     ReaderArabicFont @default(uthman)
    createdAt            DateTime         @default(now())
    updatedAt            DateTime         @updatedAt
}

/// What an inbox row is about. The client renders each from its own strings table.
enum NotificationKind {
    /// A block you volunteered for passed to somebody who joined that seat.
    POOL_CLAIM_RELEASED
    /// Somebody in the group finished their share.
    SHARE_READ
    /// The group closed the hundred.
    ROUND_COMPLETE
    /// Somebody took a block out of the shared pool.
    POOL_BAB_CLAIMED
    /// Somebody joined the group.
    MEMBER_JOINED
    /// Somebody left the group, or was removed from it.
    MEMBER_LEFT
}

model Notification {
    id        String           @id @default(cuid())
    userId    String
    kind      NotificationKind
    groupId   String?
    groupName String
    payload   Json
    readAt    DateTime?
    createdAt DateTime         @default(now())

    group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt])
    @@index([userId, readAt])
}

/// One per-screen hint this user has seen. `hintId` is the app's own name for the hint; the
/// server accepts any well-formed one, so a new hint needs no server change.
model HintSeen {
    id     String   @id @default(cuid())
    userId String
    hintId String   @db.VarChar(64)
    seenAt DateTime @default(now())

    @@unique([userId, hintId])
    @@index([userId])
}

model PushToken {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

enum FeedbackTopic {
    BUG
    IDEA
    OTHER
}

model Feedback {
    id         String        @id @default(cuid())
    reference  String        @unique
    userId     String
    topic      FeedbackTopic
    message    String
    email      String?
    appVersion String?
    platform   String?
    locale     String?
    // The app's last steps before the report, oldest first, one per line: screens with their
    // numbers and the app going to the background and back — never names or text.
    trail      String?
    createdAt  DateTime      @default(now())

    @@index([userId, createdAt])
}
