// Per-user state that isn't tied to a single group. Identity itself lives in Clerk;
// `userId` is the Clerk user id everywhere.

enum AppLanguage {
    tr
    en
}

/// Which digits the reader's verse ornaments carry.
enum ReaderNumerals {
    arabic
    latin
}

/// The face the reader sets the Arabic in. Named after the script, not the font file, so
/// swapping which family ships for `naskh` doesn't need a migration.
enum ReaderArabicFont {
    naskh
    amiri
    scheherazade
}

model UserSettings {
    id                String      @id @default(cuid())
    userId            String      @unique
    language          AppLanguage @default(en)
    reminderEnabled   Boolean     @default(false)
    reminderTime      String      @default("21:30")
    nudgeEnabled      Boolean     @default(true)
    hasSeenOnboarding Boolean     @default(false)
    readerFontScale   Int         @default(1)
    // Set from E2a, the reader's own settings sheet, and applied to every bab.
    readerNumerals    ReaderNumerals   @default(arabic)
    // Şehrizad (Scheherazade New) by default: of the three it reads closest to a printed
    // Turkish Cevşen, matched against a page of one.
    readerArabicFont  ReaderArabicFont @default(scheherazade)
    createdAt         DateTime    @default(now())
    updatedAt         DateTime    @updatedAt
}

model PushToken {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

enum FeedbackTopic {
    BUG
    IDEA
    OTHER
}

model Feedback {
    id         String        @id @default(cuid())
    reference  String        @unique
    userId     String
    topic      FeedbackTopic
    message    String
    email      String?
    appVersion String?
    platform   String?
    locale     String?
    createdAt  DateTime      @default(now())

    @@index([userId, createdAt])
}
