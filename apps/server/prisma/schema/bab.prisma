model GroupBab {
    id             String    @id @default(cuid())
    groupId        String
    number         Int
    assignedUserId String?
    readByUserId   String?
    readAt         DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, number])
    @@index([groupId, assignedUserId])
    @@index([groupId, readAt])
    @@index([readByUserId, readAt])
}

model PoolClaimRelease {
    id         String    @id @default(cuid())
    groupId    String
    userId     String
    roundIndex Int
    startBab   Int
    endBab     Int
    createdAt  DateTime  @default(now())
    seenAt     DateTime?

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@index([userId, seenAt])
    @@index([groupId, roundIndex])
}

/// A group event already announced — somebody taking a pool slot or cüz, joining, or leaving.
///
/// Each is said once per actor, per round, per subject (the slot or cüz taken; empty for a join
/// or a leave). Without it, taking and releasing in a loop — or joining and leaving an open
/// group — filed an inbox row for every member and pushed to them on every turn. The unique key
/// settles two requests at once; the next round announces itself again.
model GroupEventNotice {
    id          String   @id @default(cuid())
    groupId     String
    actorUserId String
    kind        String
    roundIndex  Int
    subject     String   @default("")
    createdAt   DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, actorUserId, kind, roundIndex, subject])
}

model ShareReadNotice {
    id         String   @id @default(cuid())
    groupId    String
    userId     String
    roundIndex Int
    createdAt  DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId, roundIndex])
    @@index([groupId, roundIndex])
}

model RoundCompleteNotice {
    id         String   @id @default(cuid())
    groupId    String
    roundIndex Int
    createdAt  DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, roundIndex])
}

model BabRead {
    id         String   @id @default(cuid())
    groupId    String
    babNumber  Int
    userId     String
    roundIndex Int
    readAt     DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, roundIndex, babNumber])
    @@index([userId, readAt])
    @@index([groupId, roundIndex])
}

/** How many times one reader has repeated a part that must be read more than once (Sekine ×19), per round. */
model GroupPartRepetition {
    id         String   @id @default(cuid())
    groupId    String
    userId     String
    roundIndex Int
    partNumber Int
    count      Int      @default(0)
    updatedAt  DateTime @updatedAt

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId, roundIndex, partNumber])
    @@index([userId])
}

/// Who holds which cüz, in which round — a **hatim's** answer to "whose is this?".
///
/// **Stored, because it cannot be derived**, and that is the one structural difference
/// between the two reading types. A Cevşen share falls out of `slotIndex + roundIndex`:
/// contiguous, equal, and written down nowhere. A hatim's holdings are none of those —
/// the design shows members on 1,2 · 10,12 · 17,19 · 7,22, and the *same* member on
/// 9,30 then 3,15 then 7,22 across three rounds. No arithmetic produces that.
///
/// **Not `GroupBab.assignedUserId`.** That column means exactly one thing — "I volunteered
/// for this out of the pool, this round" — the rollover clears it wholesale, it keeps no
/// history, and four services read it as a claim over a seat-derived block. Holdings need
/// all three of the opposites: their own meaning, survival across a boundary under KEEP,
/// and a per-round record, because "Geçen tur · 2 eksik" and the whole progress screen ask
/// what was held *then*.
///
/// Keyed by round, so a boundary is a copy-forward (KEEP) or an absence (REPICK) rather
/// than a mutation, and last round's answer stays readable after this round has moved on.
model CuzHolding {
    id         String   @id @default(cuid())
    groupId    String
    roundIndex Int
    cuzNumber  Int
    userId     String
    takenAt    DateTime @default(now())

    /// Taken out of the havuz mid-round rather than chosen on the way in — **a loan**.
    ///
    /// A loan covers the round it was made in and nothing more: it goes back to the havuz at
    /// the boundary whatever `Group.boundaryPolicy` says, because "I'll cover this spare cüz
    /// this time round" is not the same promise as the cüz you joined with. That is the same
    /// rule a Cevşen pool claim follows, where the rollover clears `assignedUserId` outright.
    ///
    /// Everything else — the owner's first pick, a joiner's selection — is `false` and is
    /// what `KEEP` carries forward.
    isLoan Boolean @default(false)

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    /// One holder per cüz per round — the guard a concurrent take loses against, the same
    /// shape `takePoolSlotForUser` relies on rather than a read-then-write.
    @@unique([groupId, roundIndex, cuzNumber])
    /// "What do I hold this round", and the cap check that rides with it.
    @@index([groupId, roundIndex, userId])
    @@index([userId])
}

/// A member sitting one round of a hatim out — QR1's "Bu turu atla".
///
/// A member of a running hatim must hold a cüz to open the group: the round-start screen will
/// not let them past with nothing. Skipping is the one chosen way through — their cüz go back
/// to the havuz, the group opens with nothing to read, and the next round asks again, since
/// this row belongs to its own round and nothing carries it forward. Stored on the server so
/// the choice holds on every device the member uses.
model CuzRoundSkip {
    id         String   @id @default(cuid())
    groupId    String
    userId     String
    roundIndex Int
    createdAt  DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId, roundIndex])
    @@index([userId])
}

/// Where a member is inside one unit of a board group's round — a cüz, a bab or a Hizb portion —
/// so the reader opens there again on any device. Only ever read or written by its own member.
///
/// Belongs to its round: a group that keeps its cüz hands the same cüz back next round, unread,
/// so last round's place means nothing then. A personal-plan group keeps its place on the plan
/// reading's `bookmark` instead, and has no rows here.
model ReadingPlace {
    id              String   @id @default(cuid())
    groupId         String
    userId          String
    roundIndex      Int
    unitNumber      Int
    /// The page within the unit, 1-based — "Kaldığım yer". Null while only pages read are known.
    position        Int?
    /// A cüz's pages turned past this round, per pagination (the typeset pages, Hüsrev's own) —
    /// Ana sayfa's "4/20 s". Only ever raised.
    textPagesRead   Int      @default(0)
    husrevPagesRead Int      @default(0)
    updatedAt       DateTime @updatedAt

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId, roundIndex, unitNumber])
    @@index([userId])
}
