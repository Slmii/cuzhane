model GroupBab {
    id             String    @id @default(cuid())
    groupId        String
    number         Int
    assignedUserId String?
    readByUserId   String?
    readAt         DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, number])
    @@index([groupId, assignedUserId])
    @@index([groupId, readAt])
    @@index([readByUserId, readAt])
}

model BabRead {
    id         String   @id @default(cuid())
    groupId    String
    babNumber  Int
    userId     String
    roundIndex Int
    readAt     DateTime @default(now())

    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([groupId, roundIndex, babNumber])
    @@index([userId, readAt])
    @@index([groupId, roundIndex])
}
