model HizbEnrollment {
    id               String   @id @default(cuid())
    groupId          String
    userId           String
    planDays         Int
    planVersion      Int      @default(1)
    ordinal          Int      @default(0)
    sequence         Int
    joinedDay        Int
    endDay           Int?
    reason           String?
    removalDays      Int?
    lastReadDay      Int?
    generatedThrough Int
    createdAt        DateTime @default(now())
    group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
    assignments      HizbAssignment[]

    @@unique([groupId, planDays, sequence])
    @@index([groupId, userId, endDay])
}

model HizbAssignment {
    id           String   @id @default(cuid())
    enrollmentId String
    day          Int
    portion      Int
    traversal    Int
    repetitions  Int      @default(0)
    delailRepetitions Int @default(0)
    istighfarRepetitions Int @default(0)
    istighfarTarget Int @default(11)
    version      Int      @default(0)
    bookmark     Int      @default(0)
    completedAt  DateTime?
    enrollment   HizbEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

    @@unique([enrollmentId, day])
    @@index([day, completedAt])
}
