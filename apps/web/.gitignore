# Env (keep .env.example tracked)
.env
.env.local
.env.*.local
!.env.example

# Expo
.expo
.expo-shared

# Native projects (regenerated by `expo prebuild`). Anchored: our own modules' `ios/` and
# `android/` (`modules/*`) are source, not generated.
/ios/
/android/
# What Gradle builds inside a local module.
modules/*/android/build/
modules/*/android/.cxx/
