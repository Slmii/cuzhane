{
	"extends": "expo/tsconfig.base.json",
	"compilerOptions": {
		"strict": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "dist", "build"]
}
