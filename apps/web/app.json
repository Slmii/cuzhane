{
	"expo": {
		"name": "Cüzhane",
		"slug": "cuzhane",
		"version": "1.4.0",
		"scheme": "cuzhane",
		"icon": "./src/assets/icon.png",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": false,
			"usesAppleSignIn": true,
			"icon": "./src/assets/icon.png",
			"bundleIdentifier": "com.cuzhaneapp.app",
			"buildNumber": "1",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"NSCameraUsageDescription": "Use your camera to upload a profile photo.",
				"NSPhotoLibraryUsageDescription": "Allow access to your photos to set a profile picture.",
				"CFBundleAllowMixedLocalizations": true,
				"UIBackgroundModes": ["audio"]
			}
		},
		"locales": {
			"tr": "./locales/tr.json",
			"en": "./locales/en.json",
			"nl": "./locales/nl.json"
		},
		"android": {
			"package": "com.cuzhaneapp.app",
			"googleServicesFile": "./google-services.json",
			"adaptiveIcon": {
				"foregroundImage": "./src/assets/icon-android.png",
				"backgroundColor": "#3E6B5C"
			},
			"permissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.FOREGROUND_SERVICE",
				"android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
				"android.permission.FOREGROUND_SERVICE_MICROPHONE"
			],
			"blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
		},
		"plugins": [
			"expo-asset",
			"expo-font",
			"expo-secure-store",
			"expo-notifications",
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow access to your photos to set a profile picture.",
					"cameraPermission": "Allow camera access to capture a profile picture."
				}
			],
			"react-native-bottom-tabs",
			"@clerk/expo",
			"@react-native-community/datetimepicker",
			[
				"expo-splash-screen",
				{
					"image": "./src/assets/splash.png",
					"resizeMode": "contain",
					"backgroundColor": "#3E6B5C",
					"dark": {
						"image": "./src/assets/splash-dark.png",
						"backgroundColor": "#0C0D0C"
					}
				}
			],
			"expo-status-bar",
			"expo-web-browser",
			[
				"@config-plugins/react-native-webrtc",
				{
					"microphonePermission": "Birlikte okurken seni takip edenler sesini canlı duyabilsin. Ses kaydedilmez."
				}
			],
			"./plugins/withCustomSymbols",
			"./plugins/withQuotedBundleScript"
		],
		"extra": {
			"eas": {
				"projectId": "134b5179-d281-4abb-bce5-fdca471acdee"
			}
		},
		"owner": "devsc05",
		"runtimeVersion": "1.0.0",
		"updates": {
			"url": "https://u.expo.dev/134b5179-d281-4abb-bce5-fdca471acdee"
		}
	}
}
