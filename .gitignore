# OS
.DS_Store

# Secrets. Declared at the root, for every folder — `apps/server` had its own rule and
# `deploy/` had none, so the deployment `.env` that `deploy/.env.example` tells you to create
# (Postgres password, live Clerk secret) was untracked-but-not-ignored and one `git add -A`
# away from a public repository.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Dependencies
node_modules
**/node_modules

# Build outputs
dist
**/dist

# Test coverage
coverage
**/coverage

# Logs
*.log

# Expo
.expo
.expo-shared

# Astro's generated types and content cache, rewritten on every build
apps/marketing/.astro
apps/marketing/marketing-video

.tanstack
.playwright-mcp
