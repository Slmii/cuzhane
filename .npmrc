# Metro and React Native resolve poorly against pnpm's default symlinked store, and
# patch-package rewrites files inside node_modules — both need a flat tree.
node-linker=hoisted

# zeego pins an exact peer (react-native-ios-context-menu 3.1.0) that the version this
# app actually runs exceeds. This is the pnpm equivalent of npm's legacy-peer-deps.
strict-peer-dependencies=false
