# Caddy issues and renews the certificate itself; there is no certbot and no cron. It needs
# ports 80 and 443 open and the domain's A record already pointing at this droplet — the
# ACME challenge is answered on 80.
#
# CI copies this file to the droplet on every deploy; edit it here, not there.
{
	email {$ACME_EMAIL}

	servers {
		# Without these, a client can hold a connection open indefinitely by dribbling out a
		# body — cheap for the attacker, and on a 2 GB box a few thousand of them are not
		# cheap for us. Express's 300 KB JSON limit only applies once a body has arrived.
		timeouts {
			read_body 10s
			read_header 5s
			write 30s
			idle 2m
		}
	}
}

# The Hüsrev mushaf's page images, `/mushaf/page-NNN.png`, answered from disk on both API domains
# before anything reaches Express — the same path the dev API serves, so the app does not change.
# Uploaded by hand into /opt/cuzhane/mushaf (see deploy/README.md), mounted at /srv/mushaf; the
# root is /srv so the URL's own `/mushaf/` is the folder. A page never changes, so a year's cache;
# `cross-origin` so the web build may draw one, as the dev route allows.
(mushaf) {
	handle /mushaf/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header Cross-Origin-Resource-Policy cross-origin
		file_server
	}
}

# The marketing site: static files, built by CI and rsynced into /opt/cuzhane/www. Its own
# certificate, issued the same way — the A record for this name must point here too.
{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv/www
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Astro fingerprints everything under `_astro/`, so those files can be cached forever;
	# the HTML around them must not be, or a deploy would not reach anyone.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /*.html Cache-Control "public, max-age=0, must-revalidate"

	log {
		output stdout
	}
}

# The preview API, for the `development` branch and the Expo `preview` channel. Same shape as
# production below, one container and one database over — see `compose.yml`. Its A record has to
# point here before Caddy can answer the ACME challenge on 80.
{$PREVIEW_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 300KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
	}

	import mushaf

	handle {
		reverse_proxy api-preview:3001
	}
}

{$DOMAIN} {
	encode zstd gzip

	# The API accepts nothing larger than 300 KB of JSON, so refuse the rest at the edge
	# rather than proxying it.
	request_body {
		max_size 300KB
	}

	# Helmet sets these on the API's own responses, but Caddy answers some requests itself —
	# redirects, proxy errors, TLS failures — and those never reach Express.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# So an incident can be reconstructed. Rotation is the container's, via compose's logging
	# options — nothing is written to disk here.
	log {
		output stdout
	}

	import mushaf

	handle {
		reverse_proxy api:3001
	}
}
