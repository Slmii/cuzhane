# Copy to /opt/cuzhane/.env on the droplet, fill in, and `chmod 600` it. Never commit the
# filled version — the repo's `.gitignore` refuses `.env` anywhere, which is the only thing
# standing between `git add -A` in this folder and a live Clerk secret in a public repo.

# The API's hostname. Its A record must already point at this droplet, or Caddy cannot
# complete the ACME challenge and will retry in a loop.
DOMAIN=api.example.com
# The preview API's hostname — the `development` branch and the Expo `preview` channel. Same
# rule: its A record must point here first. It is a separate Caddy site and gets its own
# certificate, so a typo here fails only preview.
PREVIEW_DOMAIN=preview-api.example.com
# The marketing site's hostname. Its A record must point at this droplet too — Caddy serves
# both names and issues a certificate for each.
SITE_DOMAIN=cuzhane.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Generate once, keep it: `openssl rand -hex 32`.
#
# **Hex, not base64.** This value is spliced raw into a URI in `compose.yml`
# (`postgresql://cuzhane:PASSWORD@postgres:5432/cuzhane`), and `rand -base64` emits `/` about
# half the time — a `/` ends the authority component, so Prisma cannot parse the URL and the
# API fails to reach a database that is perfectly healthy. Worse, Postgres only reads this
# variable when it first initialises the volume, so correcting the file afterwards changes
# nothing and the password has to be reset by hand. Must contain none of: / @ : # ? % + =
POSTGRES_PASSWORD=

# From the Clerk **production** instance, not the development one.
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_

# The Quran Foundation API credentials — the verse meal in the Kuran reader is fetched through
# them, server-side. Optional: left blank, the API boots and only the meal is unavailable.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# Optional. The App Store listing, once it exists.
APP_STORE_URL=

# CI overrides this per deploy with the commit sha. The value here is only the fallback for a
# manual `docker compose up` on the box, and it is what a rollback is set to — see README.md.
# Which commit each API runs. CI sets both on the fly — production's from a push to `main`,
# preview's from a push to `development` — and they move independently on purpose: deploying
# preview must never change what production is running.
IMAGE_TAG=latest
PREVIEW_IMAGE_TAG=latest

# Which compose files make up the stack: the shared one, and preview's API over it. CI writes it
# on every deploy; it is here so a plain `docker compose` on the box sees both.
COMPOSE_FILE=compose.yml:compose.preview.yml
